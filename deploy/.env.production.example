# Plantilla de ~/notas/.env en la VPS (chmod 600, fuera de las releases). Lo lee docker compose con
# --env-file solo para interpolar deploy/docker-compose.yml: ningún contenedor recibe este archivo entero.

# Contraseña del usuario "notas" de Postgres. Solo hexadecimal porque va dentro de DATABASE_URL.
# Generar con: openssl rand -hex 24
# OJO: Postgres solo lee esta variable al crear el volumen. Cambiarla después NO cambia la contraseña real:
# hay que correr también  ALTER USER notas PASSWORD '<nueva>';  dentro de la base (docker compose exec db psql).
POSTGRES_PASSWORD=

# DATABASE_URL NO va acá: el compose la arma para la app como
#   postgres://notas:${POSTGRES_PASSWORD}@db:5432/notas
# ("db" es el nombre del servicio de Postgres en la red interna del proyecto).

# Código para registrarse en /registro. Vacío = registro deshabilitado. Generar con: openssl rand -hex 8
INVITE_CODE=

# URL pública, sin barra final: issuer de OAuth y base del MCP (<APP_URL>/mcp). Obligatoria.
APP_URL=https://notas.example.com

# Proxies delante de la app: solo Caddy.
# Supone que Caddy recibe las conexiones directamente de los clientes (sin proxy de Cloudflare delante) y que
# el Caddyfile global no define trusted_proxies. Si eso cambia, revisar este valor (afecta a la IP del
# cliente que usan los límites de frecuencia).
TRUSTED_PROXY_HOPS=1

# Opcional: 1 = no programar la limpieza diaria.
NOTAS_DISABLE_MAINTENANCE=

# Notificaciones push (opcional). Sin estas tres variables la app funciona igual, sin notificaciones.
# Generar las claves UNA vez, en la VPS, sin que la privada pase por la terminal (ver Plan 7, Task B1):
#   docker run --rm node:24-bookworm-slim sh -c 'npx -y web-push@3.6.7 generate-vapid-keys --json'
# Cambiarlas invalida las suscripciones existentes (cada dispositivo tiene que volver a activar).
# VAPID_SUBJECT: contacto para los servicios de push, "https://<tu dominio>" o "mailto:<email>".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
