# Vacío en desarrollo = base PGlite local en .data/pglite
DATABASE_URL=
# Código que hay que ingresar para registrarse. Sin valor, el registro está deshabilitado.
INVITE_CODE=
# Cantidad de proxies delante de la app; el puerto de la app no debe quedar expuesto directamente
TRUSTED_PROXY_HOPS=1
# URL pública de la app, sin barra final. Es el issuer de OAuth y la base del MCP (<APP_URL>/mcp).
# Obligatoria en producción; en desarrollo, vacía = http://localhost:3000
APP_URL=

# 1 = no programar la limpieza diaria (sesiones vencidas, papelera de más de 30 días, datos OAuth vencidos).
# Con NODE_ENV=test nunca corre.
NOTAS_DISABLE_MAINTENANCE=

# Notificaciones push (opcional; vacías = apagadas). Generar con: node scripts/generate-vapid.mjs --env
# VAPID_SUBJECT: "mailto:<email>" o "https://<dominio>". Chrome acepta push en http://localhost.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
